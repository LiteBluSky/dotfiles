{{ $profile := env "CHEZMOI_PROFILE" | default "home" }}
[data]
    profile = {{ $profile | quote }}
    [data.packages]
        # Core Shell & Terminal Architecture
        nushell         = { windows = "nu",             linux = "nushell",      nixos = "" }
        wezterm         = { windows = "wezterm",        linux = "wezterm",      nixos = "wezterm" }
        nvim            = { windows = "neovim",         linux = "neovim",       nixos = "neovim" }
        starship        = { windows = "starship",       linux = "starship",     nixos = "starship" }
        fastfetch       = { windows = "fastfetch",      linux = "fastfetch",    nixos = "fastfetch" }
        lazygit         = { windows = "lazygit",        linux = "lazygit",      nixos = "lazygit" }
        opencode        = { windows = "opencode",       linux = "",             nixos = "" }

        # Main CLI Utilities
        yazi            = { windows = "yazi",           linux = "yazi",         nixos = "yazi" }
        tuxedo          = { windows = "tuxedo",         linux = "tuxedo",       nixos = "" }
        ffmpeg          = { windows = "ffmpeg",         linux = "ffmpeg",       nixos = "ffmpeg" }
        jq              = { windows = "jq",             linux = "jq",           nixos = "jq" }
        fd              = { windows = "fd",             linux = "fd-find",      nixos = "fd" }
        ripgrep         = { windows = "ripgrep",        linux = "ripgrep",      nixos = "ripgrep" }
        fzf             = { windows = "fzf",            linux = "fzf",          nixos = "fzf" }
        zoxide          = { windows = "zoxide",         linux = "zoxide",       nixos = "zoxide" }

        # Heavy System Dependencies & Core Libraries
        sevenzip        = { windows = "7zip",           linux = "p7zip-full",   nixos = "p7zip" }
        poppler         = { windows = "poppler",        linux = "poppler-utils", nixos = "poppler-utils" }
        resvg           = { windows = "resvg",          linux = "resvg",        nixos = "resvg" }
        imagemagick     = { windows = "imagemagick",    linux = "imagemagick",  nixos = "imagemagick" }

        # nixos only
        gcc = { windows = "", linux = "gcc", nixos = "gcc" }
        gnumake = { windows = "", linux = "make", nixos = "gnumake" }
        tree-sitter = { windows = "", linux = "tree-sitter", nixos = "tree-sitter" }

        # Windows-Only Runtimes (Mapped to pass safely or skip on Linux targets)
        vcredist2022    = { windows = "vcredist2022",   linux = "",             nixos = "" }

        # Custom Shell Extensions
        terminal_icons  = { windows = "terminal-icons", linux = "",             nixos = "" }

        # Utilities and Apps
        zen             = { windows = "zen-browser",    linux = "zen",          nixos = "" }

        # Programs to include on home profile
        {{ if eq $profile "home" }}
        localsend       = { windows = "localsend",      linux = "",             nixos = "localsend" }
        translucenttb   = { windows = "translucenttb",  linux = "",             nixos = "" }
        
        # Programs to include on work profile
        {{ else if eq $profile "work" }}
        # Add your future work apps right here!
        {{ end }}
