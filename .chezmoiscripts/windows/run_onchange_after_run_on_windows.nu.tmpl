{{ if eq .chezmoi.os "windows" -}}
# Generated dynamically by Chezmoi for Windows
print -e $"(ansi green)=== Running Scoop Installer Layer ===(ansi reset)"

# 1. Initialize Required Buckets Safely
do { ^scoop bucket add extras } | complete

# 2. Extract Windows Packages from Master Data Template
let scoop_pkgs = [
    {{- range .packages }}
    {{- if ne .windows "" }}
    "{{ .windows }}",
    {{- end }}
    {{- end }}
]

# 3. Clean Loop Execution
let scoop_root = ($env.SCOOP? | default $"($env.USERPROFILE)\\scoop")
let scoop_global = ($env.SCOOP_GLOBAL? | default $"($env.ProgramData)\\scoop")

for pkg in $scoop_pkgs {
    let installed = (($"($scoop_root)\\apps\\($pkg)" | path exists) or ($"($scoop_global)\\apps\\($pkg)" | path exists))
    if $installed {
        print $"(ansi dark_gray)($pkg) is already installed, checking for updates...(ansi reset)"
        ^scoop update $pkg
    } else {
        print $"(ansi yellow)Installing ($pkg) via Scoop...(ansi reset)"
        ^scoop install $pkg
    }
}
{{ end -}}
